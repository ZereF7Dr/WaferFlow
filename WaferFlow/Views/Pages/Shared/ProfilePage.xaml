<Page x:Class="WaferFlow.Views.Pages.Shared.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Профиль пользователя"
      Background="#F0F8FF">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <TextBlock Text="Мой профиль" 
                      FontSize="24" 
                      FontWeight="Bold"
                      Foreground="#4682B4"
                      Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" 
                        Width="80" Height="80" 
                        CornerRadius="40" 
                        Background="#E0E0E0"
                        Margin="0,0,20,0">
                    <Grid>
                        <Image x:Name="imgAvatar" 
                               Width="80" Height="80"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry RadiusX="40" RadiusY="40" Center="40,40"/>
                            </Image.Clip>
                        </Image>
                        <TextBlock x:Name="txtInitialsInAvatar"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#666"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="btnChangeAvatar"
                            Content="Сменить аватарку"
                            Width="140"
                            Padding="8,5"
                            Background="#4682B4"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnChangeAvatar_Click"/>
                </StackPanel>
            </Grid>

            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="ФИО" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtFirstName" Grid.Column="0" Margin="0,0,5,0" Height="35" Padding="5"/>
                        <TextBox x:Name="txtLastName" Grid.Column="1" Margin="0,0,5,0" Height="35" Padding="5"/>
                        <TextBox x:Name="txtPatronymic" Grid.Column="2" Height="35" Padding="5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Email" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail" Height="35" Padding="5"/>
                </StackPanel>
            </Border>

            
            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="15"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Роль" FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtRole" Grid.Column="1" FontWeight="Bold" Foreground="#4682B4"/>
                </Grid>
            </Border>

            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="15"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Смена" FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtShift" Grid.Column="1"/>
                </Grid>
            </Border>

            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="15"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Последний вход" FontSize="12" Foreground="#666" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtLastLogin" Grid.Column="1" Foreground="#666"/>
                </Grid>
            </Border>

            <Button x:Name="btnSaveProfile"
                    Content=" Сохранить изменения"
                    Width="200"
                    Height="40"
                    Margin="0,0,0,15"
                    Background="#4682B4"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnSaveProfile_Click"/>

            <TextBlock x:Name="txtMessage" 
                       Foreground="Red" 
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed"/>

        </StackPanel>
    </ScrollViewer>
</Page>