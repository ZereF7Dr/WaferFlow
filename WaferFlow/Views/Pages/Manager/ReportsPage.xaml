<Page x:Class="WaferFlow.Views.Pages.Manager.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчёты"
      Background="#F0F8FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="White" 
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Производственная аналитика" 
                          FontSize="18" 
                          FontWeight="Bold"
                          Foreground="#4682B4"
                          Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Период:" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="PeriodCombo" Grid.Column="1" Height="30">
                        <ComboBoxItem Content="Сегодня" Tag="today" IsSelected="True"/>
                        <ComboBoxItem Content="Неделя" Tag="week"/>
                        <ComboBoxItem Content="Месяц" Tag="month"/>
                        <ComboBoxItem Content="Всё время" Tag="all"/>
                    </ComboBox>

                    <Button x:Name="RefreshBtn" 
                            Grid.Column="2" 
                            Content="Обновить" 
                            Width="90" Height="30"
                            Margin="10,0,0,0"
                            Background="#4682B4"
                            Foreground="White"
                            BorderThickness="0"/>

                    <Button x:Name="ExportBtn" 
                            Grid.Column="3" 
                            Content="Экспорт" 
                            Width="90" Height="30"
                            Margin="10,0,0,0"
                            Background="#27AE60"
                            Foreground="White"
                            BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Всего пластин" FontSize="12" Foreground="#666"/>
                        <TextBlock x:Name="TotalText" FontSize="24" FontWeight="Bold" Foreground="#4682B4" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Классифицировано" FontSize="12" Foreground="#666"/>
                        <TextBlock x:Name="ClassifiedText" FontSize="24" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Брак" FontSize="12" Foreground="#666"/>
                        <TextBlock x:Name="RejectedText" FontSize="24" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#F5F5F5" CornerRadius="8" Padding="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Процент брака" FontSize="12" Foreground="#666"/>
                        <TextBlock x:Name="RateText" FontSize="24" FontWeight="Bold" Foreground="#E67E22" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="10"
                Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Список пластин" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <DataGrid x:Name="WafersGrid" 
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          Height="350">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialNumber}" Width="120"/>
                        <DataGridTextColumn Header="Партия" Binding="{Binding BatchNumber}" Width="100"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="100"/>
                        <DataGridTextColumn Header="Назначение" Binding="{Binding GenerationName}" Width="150"/>
                        <DataGridTextColumn Header="Дата измерения" Binding="{Binding MeasurementTime, StringFormat=dd.MM.yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Оператор" Binding="{Binding OperatorName}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TableStatusText" 
                           Grid.Row="1"
                           Foreground="Gray" 
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           VerticalAlignment="Bottom"/>
            </Grid>
        </Border>
    </Grid>
</Page>