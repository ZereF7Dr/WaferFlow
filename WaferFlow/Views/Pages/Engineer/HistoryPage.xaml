<Page x:Class="WaferFlow.Views.Pages.Engineer.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="История классификации"
      Background="#F0F8FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="White" 
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="История классификации пластин" 
                          FontSize="18" 
                          FontWeight="Bold"
                          Foreground="#4682B4"
                          Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" 
                             Grid.Column="0"
                             Height="30" 
                             Padding="5"
                             Margin="0,0,10,0"
                             ToolTip="Поиск по серийному номеру, партии, инженеру"/>

                    <DatePicker x:Name="DateFromPicker" 
                                Grid.Column="1"
                                Height="30"
                                Margin="0,0,10,0"
                                ToolTip="Дата от"/>

                    <DatePicker x:Name="DateToPicker" 
                                Grid.Column="2"
                                Height="30"
                                Margin="0,0,10,0"
                                ToolTip="Дата до"/>

                    <ComboBox x:Name="FilterCombo" 
                              Grid.Column="3"
                              Height="30"
                              Margin="0,0,10,0">
                        <ComboBoxItem Content="Все решения" Tag="all" IsSelected="True"/>
                        <ComboBoxItem Content="Одобрено" Tag="Approve"/>
                        <ComboBoxItem Content="Брак" Tag="Reject"/>
                    </ComboBox>

                    <Button x:Name="RefreshButton" 
                            Grid.Column="4"
                            Content="Обновить" 
                            Width="70" Height="30"
                            Margin="0,0,10,0"
                            Background="#4682B4"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <Button x:Name="ResetFiltersButton" 
                            Grid.Column="5"
                            Content="Сброс" 
                            Width="70" Height="30"
                            Background="#E67E22"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Сбросить все фильтры"/>

                    <Button x:Name="ExportPassportButton" 
                            Grid.Column="6"
                            Content="Паспорт" 
                            Width="70" Height="30"
                            Background="#FFA500"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Паспорт пластины"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="10"
                Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="HistoryGrid" 
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          Height="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialNumber}" Width="120"/>
                        <DataGridTextColumn Header="Партия" Binding="{Binding BatchNumber}" Width="100"/>
                        <DataGridTextColumn Header="Решение" Binding="{Binding DecisionText}" Width="80"/>
                        <DataGridTextColumn Header="Назначенное поколение" Binding="{Binding GenerationName}" Width="180"/>
                        <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="200"/>
                        <DataGridTextColumn Header="Инженер" Binding="{Binding EngineerName}" Width="120"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding DecisionTime, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button x:Name="ExportButton" 
                        Grid.Row="1"
                        Content="Экспорт в CSV" 
                        Width="100" Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,10,10"
                        Background="#27AE60"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <TextBlock x:Name="StatusText" 
                           Grid.Row="1"
                           Foreground="Gray" 
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           VerticalAlignment="Bottom"/>
                
            </Grid>
        </Border>
    </Grid>
</Page>