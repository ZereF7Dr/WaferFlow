<Page x:Class="WaferFlow.Views.Pages.Admin.EquipmentManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление оборудованием"
      Background="#F0F8FF">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
                Background="White" 
                CornerRadius="10"
                Padding="15"
                Margin="0,0,15,0">
            <StackPanel>
                <TextBlock Text="Управление оборудованием" 
                          FontSize="18" 
                          FontWeight="Bold"
                          Foreground="#4682B4"
                          Margin="0,0,0,15"/>

                <TextBox x:Name="txtSearch" 
                         Height="30" 
                         Padding="5"
                         Margin="0,0,0,10"
                         ToolTip="Поиск по названию, серийному номеру"
                         TextChanged="TxtSearch_TextChanged"/>

                <ListBox x:Name="lstEquipment" 
                         Height="450"
                         SelectionChanged="LstEquipment_SelectionChanged"/>

                <TextBlock x:Name="txtListStatus" 
                           Foreground="Gray" 
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="11"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" 
                Background="White" 
                CornerRadius="10"
                Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Редактирование оборудования" 
                              FontSize="16" 
                              FontWeight="Bold"
                              Foreground="#4682B4"
                              Margin="0,0,0,15"/>

                    <TextBlock Text="Название" FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEquipmentName" Height="35" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Серийный номер" FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtSerialNumber" Height="35" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Статус" FontSize="11" Foreground="#666" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbStatus" Height="35" Margin="0,0,0,10">
                        <ComboBoxItem Content="Активно" Tag="Active" IsSelected="True"/>
                        <ComboBoxItem Content="В ремонте" Tag="Maintenance"/>
                        <ComboBoxItem Content="Не активно" Tag="Inactive"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Сохранить" 
                               Width="90" Height="35"
                               Margin="0,0,10,0"
                               Background="#4682B4"
                               Foreground="White"
                               BorderThickness="0"
                               Cursor="Hand"
                               Click="BtnSave_Click"/>
                        <Button Content="Добавить" 
                               Width="90" Height="35"
                               Margin="0,0,10,0"
                               Background="#27AE60"
                               Foreground="White"
                               BorderThickness="0"
                               Cursor="Hand"
                               Click="BtnAdd_Click"/>
                        <Button Content="Удалить" 
                               Width="90" Height="35"
                               Background="#E74C3C"
                               Foreground="White"
                               BorderThickness="0"
                               Cursor="Hand"
                               Click="BtnDelete_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="txtMessage" 
                               Foreground="Red" 
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>